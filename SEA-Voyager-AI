<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title>SEA Voyager AI</title>

<style>

body{

background:#f2f5ff;

font-family:Arial;

display:flex;

justify-content:center;

margin-top:50px;

}

.container{

width:700px;

background:white;

padding:25px;

border-radius:15px;

box-shadow:0 0 15px rgba(0,0,0,.15);

}

h1{

text-align:center;

}

#chat{

height:400px;

overflow:auto;

border:1px solid #ddd;

padding:15px;

margin-bottom:15px;

}

textarea{

width:100%;

height:60px;

}

button{

margin-top:10px;

padding:10px 20px;

font-size:16px;

cursor:pointer;

}

.user{

color:blue;

margin:10px 0;

}

.ai{

color:green;

margin:10px 0;

}

</style>

</head>

<body>

<div class="container">

<h1>🚢 SEA Voyager AI</h1>

<p align="center">

Offline AI Companion for SSEAYP

</p>

<div id="chat"></div>

<textarea id="input"></textarea>

<br>

<button onclick="sendMessage()">

Send

</button>

</div>

<script>

async function sendMessage(){

const input=document.getElementById("input");

const message=input.value;

document.getElementById("chat").innerHTML+=

"<div class='user'><b>You:</b> "+message+"</div>";

input.value="";

const response=await fetch("http://127.0.0.1:1234/v1/chat/completions",{

method:"POST",

headers:{

"Content-Type":"application/json"

},

body:JSON.stringify({

model:"google/gemma-4-e4b",

messages:[

{

role:"user",

content:message

}

]

})

});

const data=await response.json();

const reply=data.choices[0].message.content;

document.getElementById("chat").innerHTML+=

"<div class='ai'><b>SEA Voyager AI:</b> "+reply+"</div>";

}

</script>

</body>

</html>